PORT=3008
NODE_ENV=development

# Where the other services run.
# Inside docker-compose use the service names (these defaults).
# If you run with "npm run dev" on your own machine, use localhost instead:
SCHOOL_USER_SERVICE_URL=http://school-user-service:3001
ATTENDANCE_SERVICE_URL=http://attendance-service:3003

# Browser origin(s) of the web portal, comma separated
CORS_ORIGIN=http://localhost:3000

# IMPORTANT: also copy the Keycloak / AUTH_DISABLED lines from
# attendance-service/.env.example into your report-service .env,
# because the shared auth middleware needs them.
