generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["school_user"]
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  ADMIN
  SCHOOL_ADMIN
  TEACHER
  PARENT
  STUDENT

  @@schema("school_user")
}

enum RegistrationStatus {
  UNDER_REVIEW
  APPROVED
  REJECTED

  @@schema("school_user")
}

enum LinkRequestStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("school_user")
}

enum Relationship {
  FATHER
  MOTHER
  GUARDIAN

  @@schema("school_user")
}

// ==========================================
// 1. SCHOOL
// ==========================================

model School {
  id           String  @id @default(uuid())
  censusNumber String? @unique

  name    String
  email   String  @unique
  phone   String?
  address String?
  logoUrl String?

  schoolType    String
  principalName String
  region        String
  district      String

  studentCount Int
  teacherCount Int

  verificationDocUrl String?

  // Proposed administrator details
  adminEmail     String
  adminFirstName String
  adminLastName  String

  status   RegistrationStatus @default(UNDER_REVIEW)
  isActive Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  students     Student[]
  teachers     Teacher[]
  classes      Class[]
  linkRequests LinkRequest[]

  @@map("schools")
  @@schema("school_user")
}

// ==========================================
// 2. USER
// Common account information for all roles
// ==========================================

model User {
  id         String @id @default(uuid())
  keycloakId String @unique

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id])

  fullName String
  email    String  @unique
  phone    String?

  role Role

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student?
  teacher Teacher?
  parent  Parent?

  reviewedLinkRequests LinkRequest[] @relation("LinkRequestReviewer")

  @@index([schoolId, role])
  @@map("users")
  @@schema("school_user")
}

// ==========================================
// 3. STUDENT
// ==========================================

model Student {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  classId String?
  class   Class?  @relation(fields: [classId], references: [id])

  admissionNumber String?
  dateOfBirth     DateTime?
  gender          String?

  enrollmentDate DateTime @default(now())
  isActive       Boolean  @default(true)

  parents      StudentParent[]
  linkRequests LinkRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, admissionNumber])
  @@index([schoolId, classId])
  @@map("students")
  @@schema("school_user")
}

// ==========================================
// 4. TEACHER
// ==========================================

model Teacher {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  teacherCode String?

  classTeacherOf Class? @relation("ClassTeacher")
  teaching       TeachingAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, teacherCode])
  @@index([schoolId])
  @@map("teachers")
  @@schema("school_user")
}

// ==========================================
// 5. PARENT
// ==========================================

model Parent {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  occupation String?

  students     StudentParent[]
  linkRequests LinkRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("parents")
  @@schema("school_user")
}

// ==========================================
// 6. CLASS
// ==========================================

model Class {
  id String @id @default(uuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  classTeacherId String?  @unique
  classTeacher   Teacher? @relation("ClassTeacher", fields: [classTeacherId], references: [id])

  className    String
  gradeLevel   String
  academicYear String

  isActive Boolean @default(true)

  students Student[]
  teaching TeachingAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, className, gradeLevel, academicYear])
  @@index([schoolId])
  @@map("classes")
  @@schema("school_user")
}

// ==========================================
// 7. STUDENT-PARENT
// Many-to-many relationship
// ==========================================

model StudentParent {
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  parentId String
  parent   Parent @relation(fields: [parentId], references: [id])

  relationship Relationship
  isPrimary    Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([studentId, parentId])
  @@index([parentId])
  @@map("student_parents")
  @@schema("school_user")
}

// ==========================================
// 8. LINK REQUEST
// ==========================================

model LinkRequest {
  id String @id @default(uuid())

  parentId String
  parent   Parent @relation(fields: [parentId], references: [id])

  // Information submitted by the parent
  admissionNumber String
  schoolName      String
  censusNumber    String
  nic             String
  relationship    Relationship
  documentPath    String

  // Matched school and student
  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id])

  studentId String?
  student   Student? @relation(fields: [studentId], references: [id])

  status LinkRequestStatus @default(PENDING)

  reviewedById String?
  reviewedBy   User?     @relation("LinkRequestReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  rejectReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId, status])
  @@index([schoolId, status])
  @@index([studentId, status])
  @@map("link_requests")
  @@schema("school_user")
}

model TeachingAssignment {
  id String @id @default(uuid())

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  subject String

  createdAt DateTime @default(now())

  @@unique([classId, subject])
  @@index([teacherId])
  @@map("teaching_assignments")
  @@schema("school_user")
}
